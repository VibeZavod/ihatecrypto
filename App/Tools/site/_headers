# Text files name their charset: link-preview bots (Telegram's among them) may not guess UTF-8.
/
  Content-Type: text/html; charset=utf-8
/index.html
  Content-Type: text/html; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8
# Fonts and three.js change only with a new name or a release: a returning visitor doesn't ask again.
/fonts/*
  Cache-Control: public, max-age=2592000
/three.min.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
