// The update feed at updates.ihatecrypto.ai: dist/site (appcast.xml, the zips, their notes) as a Worker's static
// files on Cloudflare. After ./release.sh <ver> https://updates.ihatecrypto.ai, publish with
//   npx wrangler deploy -c Tools/updates/wrangler.jsonc
// Static files are served free and without a request limit; one file may be at most 25 MiB (a zip is ~19 MB).
{
  "name": "ihatecrypto-updates",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../dist/site" },
  "workers_dev": false,
  "routes": [{ "pattern": "updates.ihatecrypto.ai", "custom_domain": true }]
}
