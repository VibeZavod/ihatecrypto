[
  {
    "name": "deposit into Jupiter → a drawn route waiting for Confirm",
    "send": [
      "положи 1 USDC в Jupiter"
    ],
    "expect": {
      "pending_kind": "wallet",
      "drawn_route": true,
      "steps": [
        "SOLANA",
        "JUPITER"
      ],
      "title_contains": "Jupiter"
    }
  },
  {
    "name": "buy a favorite token by symbol → its contract, never an invented address",
    "send": [
      "купи AI на 2 бакса"
    ],
    "expect": {
      "pending_kind": "wallet",
      "command_contains": "buyStock",
      "command_contains_2": "0x2E8c31162b855A2ffa90F6F8634643Ad6F111e18",
      "title_contains": "AI"
    }
  },
  {
    "name": "sell NEAR with enough of it → the NEAR Intents route",
    "send": [
      "продай весь NEAR"
    ],
    "expect": {
      "pending_kind": "wallet",
      "drawn_route": true,
      "steps": [
        "NEAR",
        "NEAR INTENTS",
        "SOLANA"
      ]
    },
    "only_if": {
      "balance": "near",
      "at_least": 0.14
    }
  },
  {
    "name": "sell NEAR with too little of it → said at once, no card",
    "send": [
      "продай весь NEAR"
    ],
    "only_if": {
      "balance": "near",
      "below": 0.14
    },
    "expect": {
      "no_pending": true,
      "reply_contains": "nothing to sell"
    }
  },
  {
    "name": "chart for a week",
    "send": [
      "покажи график эфира за неделю"
    ],
    "expect": {
      "chart": "ETH",
      "chart_range": "week",
      "no_pending": true
    }
  },
  {
    "name": "where to keep USDC → rate bubbles",
    "send": [
      "где держать USDC"
    ],
    "expect": {
      "yields": true,
      "no_pending": true
    }
  },
  {
    "name": "a greeting is conversation: a reply, no card",
    "send": [
      "привет"
    ],
    "expect": {
      "no_pending": true,
      "reply": true,
      "no_boards": [
        "chart",
        "yields",
        "allocation"
      ]
    }
  },
  {
    "name": "an unknown address-book name is asked about, never guessed",
    "send": [
      "отправь 5 USDC на Nobody Zyx"
    ],
    "expect": {
      "no_pending": true,
      "reply": true
    }
  },
  {
    "name": "«do it» from the debug API is refused and the card stays",
    "send": [
      "положи 1 USDC в Jupiter",
      "do it"
    ],
    "expect": {
      "pending_kind": "wallet",
      "reply_contains": "API",
      "not_executing": true
    }
  },
  {
    "name": "P/L for the week → the P/L board and an answer in dollars",
    "send": [
      "какой у меня P/L за неделю"
    ],
    "expect": {
      "pnl_period": "week",
      "reply_contains": "$",
      "no_pending": true
    }
  },
  {
    "name": "Russian in → Russian out: the model's chat reply",
    "send": [
      "привет, что ты умеешь?"
    ],
    "expect": {
      "no_pending": true,
      "reply_cyrillic": true
    }
  },
  {
    "name": "Russian in → Russian out: LALA's own «Understood» reply",
    "send": [
      "положи 1 USDC в Jupiter"
    ],
    "expect": {
      "pending_kind": "wallet",
      "reply_contains": "Понял"
    }
  },
  {
    "name": "English in → English out",
    "send": [
      "hi, what can you do?"
    ],
    "expect": {
      "no_pending": true,
      "reply_cyrillic": false
    }
  },
  {
    "name": "P/L on one market → the board for oil, all time",
    "send": [
      "сколько я заработал на нефти"
    ],
    "expect": {
      "pnl_period": "all",
      "reply_contains": "$",
      "no_pending": true
    }
  },
  {
    "name": "a pasted token address with a link's «2F» → the agent repairs it, opens the token's card and offers ways to go on",
    "send": [
      "расскажи про этот токен 2FB5ANwoWkptDv1QszdPHXjCF2gTWdo27FGLffdfXzzoe6"
    ],
    "expect": {
      "no_pending": true,
      "detail_contains": "token:solana:B5ANwoWkptDv1QszdPHXjCF2gTWdo27FGLffdfXzzoe6",
      "next_steps_at_least": 2,
      "reply_cyrillic": true
    }
  },
  {
    "name": "a question about a trade → the agent looks at the market and answers with its view and cards",
    "send": [
      "стоит ли сейчас шортить нефть?"
    ],
    "expect": {
      "no_pending": true,
      "reply_cyrillic": true,
      "next_steps_at_least": 2
    }
  },
  {
    "name": "a bare «long ETH» builds the plan by the rules, never «already in the plan»",
    "send": [
      "сделай лонг по эфиру"
    ],
    "expect": {
      "plan": "ETH",
      "no_pending": true
    }
  },
  {
    "name": "a price alert added to the plan on the canvas → the plan's first card, tied to it",
    "send": [
      "long SOL risk $0.3 stop 3% take 6% leverage 2x",
      "поставь алерт на 2% ниже текущей цены и добавь его в этот план"
    ],
    "expect": {
      "plan": "SOL",
      "plan_first": "WHEN",
      "no_pending": true
    }
  },
  {
    "name": "Solana → Tempo over Relay → a drawn route with Tempo's card",
    "send": [
      "переведи 2 USDC из соланы в темпо"
    ],
    "expect": {
      "pending_kind": "wallet",
      "drawn_route": true,
      "steps": [
        "SOLANA",
        "RELAY",
        "TEMPO"
      ],
      "title_contains": "Tempo"
    }
  },
  {
    "name": "pay for an API on Tempo → the service's price on a card, nothing paid",
    "send": [
      "сколько стоит биткоин? оплати запрос в coingecko через темпо"
    ],
    "expect": {
      "pending_kind": "wallet",
      "command_contains": "pay",
      "steps": [
        "PAY"
      ],
      "title_contains": "0.06"
    }
  },
  {
    "name": "the 1st of every month → a scheduled monthly task, no card",
    "send": [
      "каждое 1 число месяца в 10:00 показывай мой P/L за месяц"
    ],
    "expect": {
      "no_pending": true,
      "reply": true
    }
  },
  {
    "name": "gas is never a dead end → «добавь газа» is a card: Solana → Relay → gas",
    "send": [
      "добавь газа на робингуд на 3 бакса"
    ],
    "expect": {
      "pending_kind": "wallet",
      "drawn_route": true,
      "steps": [
        "SOLANA",
        "RELAY",
        "GAS"
      ],
      "title_contains": "Gas"
    }
  },
  {
    "name": "between two EVM networks straight → Base → Relay → Robinhood, no Solana",
    "send": [
      "переведи 5 USDC из бейза на робингуд"
    ],
    "expect": {
      "pending_kind": "wallet",
      "drawn_route": true,
      "steps": [
        "BASE",
        "RELAY",
        "ROBINHOOD"
      ],
      "title_contains": "Base → Robinhood"
    }
  },
  {
    "name": "save the canvas to a folder by words → it goes there",
    "send": [
      "save this canvas to folder UITest"
    ],
    "expect": {
      "no_pending": true,
      "reply_contains": "UITest"
    }
  },
  {
    "name": "write a note to a folder → a note of its own there",
    "send": [
      "запиши в папку UITest: проверить Ledger завтра"
    ],
    "expect": {
      "no_pending": true,
      "reply_contains": "UITest"
    }
  }
]
